# ══════════════════════════════════════════════════════
# RAPEX Technologies OPC — Environment Variables
# Copy this to .env and fill in your values
# ══════════════════════════════════════════════════════

# ─── Django ───────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=django-insecure-change-me-in-production-min-50-chars-please-rapex-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ─── Database ─────────────────────────────────────────
DB_NAME=rapex_db
DB_USER=rapex_user
DB_PASSWORD=rapex_password
DB_HOST=postgres
DB_PORT=5432

# ─── Redis ────────────────────────────────────────────
REDIS_URL=redis://:rapex_redis_pass@redis:6379/0
REDIS_PASSWORD=rapex_redis_pass
CELERY_BROKER_URL=redis://:rapex_redis_pass@redis:6379/1
CELERY_RESULT_BACKEND=redis://:rapex_redis_pass@redis:6379/2

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET_KEY=rapex-jwt-secret-key-change-in-production-min50chars
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# ─── Email (SMTP) ─────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=RAPEX <no-reply@rapex.local>
SERVER_EMAIL=RAPEX <no-reply@rapex.local>
DEV_USE_CONSOLE_EMAIL_BACKEND=False

# ─── SMS (PhilSMS primary, Semaphore fallback) ───────
SMS_PROVIDER=PHILSMS
PHILSMS_API_URL=https://app.philsms.com/api/v3/sms/send
PHILSMS_API_TOKEN=your-philsms-api-token
PHILSMS_SENDER_ID=RAPEX
SEMAPHORE_API_KEY=your-semaphore-api-key
SEMAPHORE_SENDER_NAME=RAPEX

# ─── Google Maps ──────────────────────────────────────
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ─── Google Authentication ─────────────────────────────
# Comma-separated list of OAuth Web Client IDs allowed to exchange Google ID tokens.
GOOGLE_OAUTH_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com
# Keep False in production unless you explicitly want open Admin/SuperAdmin Google signup.
GOOGLE_ALLOW_PRIVILEGED_SIGNUP=False

# ─── Firebase (FCM Push Notifications) ────────────────
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# ─── Storage (MinIO / S3) ────────────────────────────
USE_S3=False
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=rapex-media
MINIO_ENDPOINT=http://minio:9000
MINIO_USE_SSL=False

# ─── CORS ─────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004
